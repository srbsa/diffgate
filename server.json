{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.srbsa/diffgate",
  "description": "Deterministic guardrail your coding agent runs on itself: diff-scoped findings, zero LLM tokens.",
  "repository": {
    "url": "https://github.com/srbsa/diffgate",
    "source": "github"
  },
  "version": "0.8.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "diffgate-review",
      "version": "0.8.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "command"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
