# DiffGate — example environment for `diffgate marginal` runs and optional AI features.
#
# Copy to `.env` (gitignored) and fill in only the providers you use.
# DiffGate auto-loads the nearest `.env` (core/config.ts); real shell env vars always win.
# The deterministic gate/triage needs NONE of these — they're only for `diffgate marginal`,
# `diffgate_explain`, and `diffgate_deep_review`.

# --- Provider API keys (set only what you run; pick via `diffgate marginal --provider=<id>`) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=     # free tier is 5 RPM — pair with `--delay-ms=13000`
GEMINI_API_KEY=

# Local providers (lmstudio, ollama) need no key — just have the server running.

# --- Custom / self-hosted endpoint (provider=custom) ---
# DIFFGATE_MARGINAL_BASE_URL=https://your-openai-compatible-endpoint/v1
# DIFFGATE_MARGINAL_MODEL=your-model-id
